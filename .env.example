# ─────────────────────────────────────────────────────────────────────────────
# Ascend60 — Environment Variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
#   cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put server-only secrets (service role keys, REST API keys) in VITE_ vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (client) ────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url
# Public anon / publishable key (safe to expose to the browser).
# The app reads VITE_SUPABASE_PUBLISHABLE_KEY first, then falls back to
# VITE_SUPABASE_ANON_KEY — set either one.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── OneSignal (client) ───────────────────────────────────────────────────────
# Public OneSignal App ID used by the web push SDK
VITE_ONESIGNAL_APP_ID=your_onesignal_app_id

# ── App config ───────────────────────────────────────────────────────────────
# Which 60-day protocol/program loads by default. Phase 2 adds the recovery
# tracks: alcohol | opioids | weight-loss | digital-detox | productivity |
# general-health. Until then the bundled default protocol id is `looksmax`.
VITE_DEFAULT_PROTOCOL_ID=looksmax
# App environment: development | production
VITE_APP_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY secrets (used by Supabase Edge Functions / cron — NOT the client).
# Configure these as Supabase Function secrets or Postgres settings, never here.
#   SUPABASE_SERVICE_ROLE_KEY=      # set as app.settings.service_role_key
#   CRON_SECRET=                    # set as app.settings.cron_secret
#   ONESIGNAL_REST_API_KEY=         # OneSignal REST API key (server push)
#   TWILIO_ACCOUNT_SID=             # Phase 4 (SMS)
#   TWILIO_AUTH_TOKEN=              # Phase 4 (SMS)
#   TWILIO_FROM_NUMBER=             # Phase 4 (SMS)
#   OPENAI_API_KEY=                 # Phase 3 (AI coaching)
# ─────────────────────────────────────────────────────────────────────────────
